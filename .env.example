# Copy file này thành ".env" và điền key thật vào (không commit .env lên GitHub)

# Groq API - free tier, lấy key tại https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pexels API - free, lấy key tại https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# (Tùy chọn) Telegram bot để nhận video sau khi tạo xong
# Tạo bot qua @BotFather, lấy token; lấy chat_id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Tùy chọn) TikTok Content Posting API - tự đăng video ở chế độ riêng tư (SELF_ONLY)
# Xem hướng dẫn thiết lập chi tiết ở đầu file tiktok_auth.py, rồi chạy `python tiktok_auth.py`
# một lần để tự động điền TIKTOK_REFRESH_TOKEN bên dưới.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://httpbingo.org/get
TIKTOK_REFRESH_TOKEN=
